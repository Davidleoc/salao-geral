APP_NAME=MeuAgendamento
APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/salao_saas
# Assina os tokens de sessão (JWT). Use um valor aleatório forte e único.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em produção (APP_ENV=production) o sistema recusa iniciar com um valor fraco/placeholder.
SECRET_KEY=troque_por_um_valor_aleatorio_forte
EMAIL_API_KEY=your_email_api_key
EMAIL_FROM=noreply@seudominio.com
ADMIN_EMAIL=seuemail@seudominio.com
SESSION_EXPIRE_MINUTES=60
MAX_UPLOAD_MB=5

# ---- Endereço público (usado nos links dos e-mails: convite, nova senha, avaliação, calendário)
URL_BASE=http://localhost:9080

# ---- Envio de e-mail (SMTP). Sem SMTP_HOST, nada é enviado: os e-mails ficam em /dev/emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_TLS=true

# ---- Criptografia de segredos guardados no banco (ex: segredo do MFA). Se vazio, deriva do SECRET_KEY.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAVE_CRIPTOGRAFIA=

# ---- MFA (desligado enquanto está em validação)
MFA_ENABLED=false
MFA_ADMIN_OBRIGATORIO=false

# ---- Tarefas automáticas (lembretes, cobrança, lista de espera, retenção LGPD)
TAREFAS_AUTOMATICAS=true
TAREFAS_INTERVALO_MINUTOS=10
LEMBRETE_HORAS_ANTES=24

# ---- Teste grátis e cobrança
DIAS_TESTE=12
DIAS_AVISO_VENCIMENTO=5
DIAS_TOLERANCIA_ATRASO=7
# Pix "copia e cola" nos e-mails de cobrança (deixe PIX_CHAVE vazio para enviar sem código)
PIX_CHAVE=
PIX_NOME_RECEBEDOR=MeuAgendamento
PIX_CIDADE=SAO PAULO

# ---- Equipe e LGPD
CONVITE_VALIDADE_DIAS=7
RETENCAO_LOGS_DIAS=180
RETENCAO_CLIENTE_INATIVO_MESES=24
PRAZO_EXCLUSAO_CONTA_DIAS=30

# ---- Atrás de proxy (nginx/Cloudflare): true para usar o IP real do X-Forwarded-For nos limites por IP
CONFIAR_PROXY=false
